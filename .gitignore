__pycache__/
*.py[cod]

.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# `test.coverage` output — a report regenerated on demand, never a committed number.
.coverage
htmlcov/

# Build output: `dist.build` writes wheels/sdists here and `helm.package` writes chart .tgz
# archives into dist/helm/. Both are regenerated on demand and `dist.clean` wipes the directory.
dist/

# Claude Code — personal/runtime state, not shared config.
.claude/settings.local.json

# Agent skills: authored in skills/<name>/ and committed there; these are install targets, written
# per clone by `inv agents.install-skills` or by a developer trying another skill with `skills add`.
.agents/skills/
.claude/skills/
skills-lock.json
